VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: set when the API runs on a different origin (e.g. packaged Tauri builds)
VITE_API_BASE_URL=http://localhost:4000

PORT=4000
CORS_ORIGIN=http://127.0.0.1:1420,http://localhost:1420,http://127.0.0.1:3000,http://localhost:3000,tauri://localhost,http://tauri.localhost,https://tauri.localhost
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Required only if your Supabase project signs user JWTs with HS256 instead of ES256/RS256 JWKS
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
